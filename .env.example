# --- Jev (TypeSafe System One) ---
JEV_API_KEY=
# TypeSafe direto: https://api.typesafe.ai/v1  |  OpenRouter: https://openrouter.ai/api/v1
JEV_BASE_URL=https://api.typesafe.ai/v1
# TypeSafe: jev-latest  |  OpenRouter: typesafe/jev-1.13
JEV_MODEL=jev-latest
# Probabilidade minima (0-1) para tratar o email como suspeito
PHISHING_THRESHOLD=0.7

# --- Execucao ---
POLL_INTERVAL_SECONDS=60
DATA_DIR=./data
QUARANTINE_LABEL=Suspeita de Phishing

# --- Google (Gmail API) ---
# JSON do cliente OAuth "Desktop app" baixado do Google Cloud Console
GOOGLE_CLIENT_SECRETS=./credentials.json

# --- Microsoft (Graph API) ---
# Application (client) ID do app registrado no Entra ID (public client / device code)
MS_CLIENT_ID=
# common = contas pessoais e corporativas; ou o ID do tenant
MS_TENANT=common
